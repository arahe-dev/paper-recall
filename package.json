{
  "name": "recall-board-excalidraw",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:frameless": "tsc -b && vite build --mode frameless",
    "check": "pnpm run lint && pnpm run build",
    "lint": "eslint .",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:dev:frameless": "tauri dev --config src-tauri/tauri.frameless.conf.json",
    "tauri:build:frameless": "tauri build --config src-tauri/tauri.frameless.conf.json",
    "audit:js": "pnpm audit",
    "audit:rust": "cargo audit --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "d3-force": "^3.0.0",
    "dagre": "^0.8.5",
    "minisearch": "^7.1.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.0",
    "@types/d3-force": "^3.0.10",
    "@types/dagre": "^0.7.54",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "playwright": "^1.59.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10"
  }
}
